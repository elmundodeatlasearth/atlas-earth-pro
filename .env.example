# Military-Grade Security Configuration
# NEVER commit this file with real values to version control

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Encryption Key (32+ characters recommended)
VITE_ENCRYPTION_KEY=CHANGE_THIS_TO_A_SECURE_32_CHAR_KEY_BEFORE_DEPLOY

# Rate Limiting (requests per minute)
VITE_RATE_LIMIT=60

# Session Timeout (minutes)
VITE_SESSION_TIMEOUT=30
